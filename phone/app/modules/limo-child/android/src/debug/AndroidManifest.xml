<?xml version="1.0" encoding="utf-8"?>
<!--
Debug builds only. A release build is made from src/main alone and never has
this receiver or its code (src/debug/java).

dev/DevReceiver: how the development tool on the PC talks to the app over
the USB cable, with no family PC. It takes three broadcasts: PAIR (take
the test family's pairing file from files/limo-dev/pairing.json, then delete
it), FORGET (wipe the kept state) and PROBE (switch on or off the probe that
logs the class names the guard reads and the package manager's answers for
it, dev/PageProbe).
It is exported so that adb can reach it, and guarded by
android.permission.DUMP, which only the adb shell and the system hold: no app
on the phone can send to it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="ai.lucidloom.limo.child.dev.DevReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="ai.lucidloom.limo.child.dev.PAIR" />
                <action android:name="ai.lucidloom.limo.child.dev.FORGET" />
                <action android:name="ai.lucidloom.limo.child.dev.PROBE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
