<?xml version="1.0" encoding="utf-8"?>
<!--
Words Android shows for LiMo's components in Settings, and the names of its
notification channels. The pieces that fill each folder change them to say
what LiMo then does. Every word LiMo shows about time and rules comes from
the Rust engine instead; these are only Android's labels.
-->
<resources>
    <string name="limo_watch_label">LiMo</string>
    <string name="limo_watch_description">LiMo is told which app is in front, by its name only, to count screen time and to cover an app when it is blocked or the time is used up. It is never told what is on the screen.</string>
    <string name="limo_admin_label">LiMo</string>
    <!--
    The device admin (keep/AdminReceiver), shown on Android's page that asks to
    turn it on and in its list of device admin apps. It holds no policy at all
    (res/xml/limo_admin.xml): all it does is what Android does for any active
    device admin app, which cannot be removed until it is switched off.
    -->
    <string name="limo_admin_description">LiMo asks for this only so that it cannot be removed from this phone while this is on. It uses no other power of a device admin app: it cannot wipe the phone, lock it, change its screen lock or switch off its camera. To remove LiMo, switch this off first.</string>
    <!--
    The device admin (keep/AdminReceiver), when someone asks to switch it off:
    Android's Settings shows these words in its own dialog before it does,
    with OK and Cancel. LiMo's guard covers that dialog until a guardian types
    the PIN, so a guardian is the one who reads them. They must never be
    empty: with no words Settings switches the admin off at once, with no
    dialog.
    -->
    <string name="limo_admin_disable_warning">Switching this off lets LiMo be removed from this phone.</string>
    <!-- keep/: the two notification channels, as Android lists them in LiMo's notification settings. -->
    <string name="limo_channel_time_left">Time left</string>
    <string name="limo_channel_time_left_about">How much screen time is left today.</string>
    <string name="limo_channel_warnings">Warnings</string>
    <string name="limo_channel_warnings_about">A few minutes before the phone locks.</string>
</resources>
