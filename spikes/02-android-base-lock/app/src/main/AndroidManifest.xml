<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
    No permissions at all. The cover is a TYPE_ACCESSIBILITY_OVERLAY window,
    which needs only the accessibility service, not SYSTEM_ALERT_WINDOW.

    Package visibility (Android 11 and later): instead of QUERY_ALL_PACKAGES,
    ask only for the apps these intents resolve to.
    -->
    <queries>
        <!-- The app list in the activity. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Launchers: never covered. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Dialers: never covered. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <!-- Settings: never covered. -->
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <!-- Keyboards: their windows are ignored. -->
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".BlockService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/block_service" />
        </service>
    </application>
</manifest>
